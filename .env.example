# Base URL of hope-backend, including /api/v1.
#
# Local development (default): relative URL. The Vite dev server proxies /api to
# https://api.hope.bramasquare.com (see vite.config.ts), so there is no CORS and the refresh cookie works.
VITE_API_URL=/api/v1
#
# A deployed build calls the API directly instead; the backend's ALLOWED_ORIGINS must then list the front-end origin,
# and the front-end must be on the same site as the API (e.g. app.hope.bramasquare.com) for the
# SameSite=Strict refresh cookie to be sent:
# VITE_API_URL=https://api.hope.bramasquare.com/api/v1
#
# true = send X-Client-Type: web. Requires the backend CORS allowed-headers to include it.
VITE_WEB_CLIENT_HEADER=false
